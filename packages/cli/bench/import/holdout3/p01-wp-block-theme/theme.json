{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "color": "#FBFAF7", "name": "Base", "slug": "base" },
				{ "color": "#F2EFE8", "name": "Base / Two", "slug": "base-2" },
				{ "color": "#1F1D1A", "name": "Contrast", "slug": "contrast" },
				{ "color": "#5E594F", "name": "Contrast / Two", "slug": "contrast-2" },
				{ "color": "#DAD4C8", "name": "Contrast / Three", "slug": "contrast-3" },
				{ "color": "#2F5D50", "name": "Accent", "slug": "accent" },
				{ "color": "#C9E4D9", "name": "Accent / Two", "slug": "accent-2" },
				{ "color": "#B5482E", "name": "Accent / Three", "slug": "accent-3" }
			]
		},
		"custom": {
			"radius": {
				"sm": "4px",
				"md": "6px",
				"lg": "12px"
			}
		},
		"layout": {
			"contentSize": "640px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "Tiny", "size": "8px", "slug": "10" },
				{ "name": "X-Small", "size": "16px", "slug": "20" },
				{ "name": "Small", "size": "clamp(20px, 3vw, 28px)", "slug": "30" },
				{ "name": "Regular", "size": "clamp(28px, 5vw, 48px)", "slug": "40" },
				{ "name": "Large", "size": "clamp(48px, 8vw, 88px)", "slug": "50" }
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Figtree",
					"slug": "body",
					"fontFamily": "Figtree, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"src": ["file:./assets/fonts/figtree/Figtree-VariableFont_wght.woff2"]
						}
					]
				},
				{
					"name": "Fraunces",
					"slug": "heading",
					"fontFamily": "Fraunces, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"src": ["file:./assets/fonts/fraunces/Fraunces-VariableFont_SOFT,WONK,opsz,wght.woff2"]
						}
					]
				},
				{
					"name": "JetBrains Mono",
					"slug": "mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, monospace"
				}
			],
			"fontSizes": [
				{ "fluid": false, "name": "Small", "size": "0.875rem", "slug": "small" },
				{ "fluid": false, "name": "Medium", "size": "1.125rem", "slug": "medium" },
				{ "fluid": { "min": "1.25rem", "max": "1.5rem" }, "name": "Large", "size": "1.5rem", "slug": "large" },
				{ "fluid": { "min": "1.75rem", "max": "2.5rem" }, "name": "Extra Large", "size": "2.5rem", "slug": "x-large" },
				{ "fluid": { "min": "2.25rem", "max": "3.5rem" }, "name": "Extra Extra Large", "size": "3.5rem", "slug": "xx-large" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|20",
			"padding": {
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "var:preset|color|base-2",
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small"
				},
				"border": {
					"radius": "var(--wp--custom--radius--sm)"
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|contrast-2" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/post-terms": {
				"color": { "text": "var:preset|color|contrast-2" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|contrast-3" },
				"border": { "width": "1px" }
			},
			"core/search": {
				"border": {
					"color": "var(--wp--preset--color--contrast-3)",
					"radius": "var(--wp--custom--radius--md)"
				}
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontStyle": "italic" },
				"border": { "color": "var:preset|color|accent-3", "style": "solid", "width": "0 0 0 3px" }
			},
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "500" }
			}
		},
		"elements": {
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": { "top": "0.6rem", "right": "1.1rem", "bottom": "0.6rem", "left": "1.1rem" }
				},
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "600" },
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"outline": { "color": "var:preset|color|accent-2", "offset": "2px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|contrast-2" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"heading": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"link": {
				"color": { "text": "var:preset|color|accent" },
				":hover": {
					"typography": { "textDecoration": "none" }
				}
			}
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Header" },
		{ "area": "footer", "name": "footer", "title": "Footer" }
	]
}
