{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Evening",
	"settings": {
		"color": {
			"palette": [
				{ "color": "#1C1B18", "name": "Base", "slug": "base" },
				{ "color": "#26241F", "name": "Base / Two", "slug": "base-2" },
				{ "color": "#EDE9E0", "name": "Contrast", "slug": "contrast" },
				{ "color": "#A8A195", "name": "Contrast / Two", "slug": "contrast-2" },
				{ "color": "#3A372F", "name": "Contrast / Three", "slug": "contrast-3" },
				{ "color": "#8FC1AE", "name": "Accent", "slug": "accent" },
				{ "color": "#24463C", "name": "Accent / Two", "slug": "accent-2" },
				{ "color": "#E38C72", "name": "Accent / Three", "slug": "accent-3" }
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				}
			}
		}
	}
}
