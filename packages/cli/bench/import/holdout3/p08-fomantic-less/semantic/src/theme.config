/*******************************
        Theme Selection
*******************************/

/* To override a theme for an individual element
   specify theme name below
*/

/* Global */
@site       : 'default';
@reset      : 'default';

/* Elements */
@button     : 'default';
@container  : 'default';
@divider    : 'default';
@header     : 'default';
@icon       : 'default';
@input      : 'default';
@label      : 'default';
@segment    : 'default';

/* Collections */
@form       : 'default';
@grid       : 'default';
@menu       : 'default';
@message    : 'default';
@table      : 'default';

/* Modules */
@dropdown   : 'default';
@modal      : 'default';
@transition : 'default';

/* Views */
@card       : 'default';

/*******************************
            Folders
*******************************/

/* Path to theme packages */
@themesFolder : 'themes';

/* Path to site override folder */
@siteFolder  : '../../src/site';

/*******************************
         Import Theme
*******************************/

@import (multiple) "theme.less";

/* End Config */
