{
  "stack": "Bulma 0.9.4 customized with Sass (_settings.scss before @import \"bulma/bulma\")",
  "route": "direct",
  "hard": "text, muted text and border come from re-pointing Bulma's initial greys ($grey-dark, $grey, $grey-lighter) that Bulma's derived variables in node_modules read, while node_modules also holds Bulma's own turquoise/blue/red defaults; card and button text are Bulma's (white card, computed invert)",
  "light": {
    "primary": "#1f7a55",
    "background": "#f7f6f2",
    "foreground": "#2b2f36",
    "mutedText": "#6b7280",
    "border": "#dcd8cf",
    "danger": "#c2352b",
    "success": "#2e8540",
    "warning": "#e0a526"
  },
  "dark": null,
  "fonts": {
    "sans": "Manrope",
    "heading": "DM Serif Display",
    "mono": "Space Mono"
  },
  "baseSize": 15,
  "radius": 6,
  "absent": [
    "dark",
    "spacing",
    "light.primaryForeground",
    "light.card"
  ],
  "decoys": [
    "hsl(171, 100%, 41%)",
    "hsl(229, 53%,  53%)",
    "hsl(348, 86%, 61%)",
    "hsl(153, 53%,  53%)",
    "hsl(44,  100%, 77%)",
    "hsl(0, 0%, 29%)"
  ]
}
