---
interface Props {
  title: string;
  date: string;
  href: string;
  draft?: boolean;
}
const { title, date, href, draft = false } = Astro.props;
---

<article class="card">
  <h2><a href={href}>{title}</a></h2>
  <p class="meta">{date}{draft && <span class="draft"> · draft</span>}</p>
  <slot />
  <a class="button" href={href}>Read note</a>
</article>

<style>
  .card {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--size-5);
    box-shadow: var(--shadow-2);
  }

  .card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .draft {
    color: var(--danger);
  }

  .button {
    display: inline-flex;
    margin-block-start: var(--size-3);
    padding: var(--size-2) var(--size-4);
    border-radius: var(--radius-control);
    background: var(--brand);
    color: var(--on-brand);
    font-weight: var(--font-weight-6);
    text-decoration: none;
  }

  .button:hover {
    background: color-mix(in oklab, var(--brand), black 12%);
  }
</style>
