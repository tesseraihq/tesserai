    <div
      data-slot="alert-dialog-footer"
      className={cn(
        "flex flex-col-reverse gap-2 sm:flex-row sm:justify-end gap-(--space-3)",
        className,
      )}
      {...props}
    />
  );
}

function AlertDialogMedia({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="alert-dialog-media"
      className={cn(
        "mb-2 inline-flex items-center justify-center [&_svg]:size-5 bg-neutral-subtle text-neutral-text-strong rounded-md size-(--alert-dialog-media-size)",
        className,
      )}
      {...props}
    />
