}

function SidebarGroupAction({
  className,
  elementType: Element = "button",
  ...props
}: React.HTMLAttributes<HTMLElement> & { elementType?: React.ElementType }) {
  return (
    <Element
      data-slot="sidebar-group-action"
      data-sidebar="group-action"
      className={cn(
        "absolute top-3.5 end-3 flex aspect-square w-5 items-center justify-center p-0 outline-hidden transition-transform group-data-[collapsible=icon]:hidden after:absolute after:-inset-2 md:after:hidden [&>svg]:size-4 [&>svg]:shrink-0 text-neutral-text rounded-md hover:bg-neutral-subtle hover:text-neutral-text-strong focus-visible:ring-primary-focus-ring focus-visible:ring-(length:--focus-width) focus-visible:ring-offset-(length:--focus-offset) focus-visible:ring-offset-(color:--surface-page)",
        className,
      )}
      {...props}
    />
  );
}

function SidebarGroupContent({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="sidebar-group-content"
      data-sidebar="group-content"
      className={cn("w-full", className)}
      {...props}
    />
