exports[`renderAll > renders the same component set on React Aria, in React Aria's idioms 37`] = `
""use client";

import * as React from "react";
import {
  Breadcrumb as BreadcrumbPrimitive,
  Breadcrumbs as BreadcrumbsPrimitive,
  Link as LinkPrimitive,
  composeRenderProps,
  type BreadcrumbProps,
  type BreadcrumbsProps,
  type LinkProps,
} from "react-aria-components";
import { ChevronRightIcon, MoreHorizontalIcon } from "lucide-react";
import { cn } from "@/lib/utils";

function Breadcrumb(props: React.ComponentProps<"nav">) {
  return <nav aria-label="breadcrumb" data-slot="breadcrumb" {...props} />;
}

function BreadcrumbPage({ className, ...props }: React.ComponentProps<"span">) {
  return (
    <span
      data-slot="breadcrumb-page"
      role="link"
      aria-disabled="true"
      aria-current="page"
      className={cn("font-normal text-neutral-text-strong", className)}
      {...props}
    />
  );
}

function BreadcrumbEllipsis({ className, ...props }: React.ComponentProps<"span">) {
  return (
    <span
      data-slot="breadcrumb-ellipsis"
      role="presentation"
      aria-hidden="true"
      className={cn(
        "flex items-center justify-center [&>svg]:size-4 size-(--breadcrumb-ellipsis-size)",
        className,
      )}
      {...props}
    >
      <MoreHorizontalIcon />
      <span className="sr-only">More</span>
    </span>
  );
}

function BreadcrumbList<T extends object>({ className, ...props }: BreadcrumbsProps<T>) {
  return (
    <BreadcrumbsPrimitive
      data-slot="breadcrumb-list"
      className={cn(
        "flex flex-wrap items-center wrap-break-word text-neutral-text gap-(--breadcrumb-gap) text-(length:--breadcrumb-font-size)",
        className,
      )}
      {...props}
    />
  );
}

// Every item but the current one is followed by a separator.
function BreadcrumbItem({
  className,
  children,
  separatorClassName,
  ...props
}: BreadcrumbProps & { separatorClassName?: string }) {
  return (
    <BreadcrumbPrimitive
      data-slot="breadcrumb-item"
      className={composeRenderProps(className, (className) =>
        cn("inline-flex items-center gap-(--breadcrumb-gap)", className),
      )}
      {...props}
    >
      {composeRenderProps(children, (children, { isCurrent }) => (
        <>
          {children}
          {isCurrent ? null : (
            <span
              data-slot="breadcrumb-separator"
              role="presentation"
              aria-hidden="true"
              className={cn(
                "inline-flex [&>svg]:size-full rtl:rotate-180 size-(--breadcrumb-separator-size)",
                separatorClassName,
              )}
            >
              <ChevronRightIcon />
            </span>
          )}
        </>
      ))}
    </BreadcrumbPrimitive>
  );
}

function BreadcrumbLink({ className, ...props }: LinkProps) {
  return (
    <LinkPrimitive
      data-slot="breadcrumb-link"
      className={composeRenderProps(className, (className) =>
        cn(
          "outline-none transition-colors rounded-sm duration-(--duration-fast) ease-standard data-hovered:text-neutral-text-strong data-focus-visible:ring-primary-focus-ring data-focus-visible:ring-(length:--focus-width) data-focus-visible:ring-offset-(length:--focus-offset) data-focus-visible:ring-offset-(color:--surface-page)",
          className,
        ),
      )}
      {...props}
    />
  );
}

export {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbEllipsis,
};
"
`;

