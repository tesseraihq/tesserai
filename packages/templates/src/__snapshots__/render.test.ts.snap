"import * as React from "react";
import { AlertDialog as AlertDialogPrimitive } from "radix-ui";
import { cva } from "class-variance-authority";
import { Button } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const alertDialogContentVariants = cva(
  "fixed top-1/2 left-1/2 z-50 flex w-[calc(100%-2rem)] -translate-x-1/2 -translate-y-1/2 flex-col outline-none data-[state=open]:animate-enter data-[state=closed]:animate-exit bg-(color:--surface-overlay) text-neutral-text-strong shadow-lg rounded-(--alert-dialog-radius) p-(--alert-dialog-padding) gap-(--alert-dialog-gap) duration-(--duration-base) ease-enter",
  {
    variants: {
      size: {
        sm: "max-w-(--alert-dialog-max-width-sm)",
        md: "max-w-(--alert-dialog-max-width-md)",
      },
    },
    compoundVariants: [],
    defaultVariants: { size: "md" },
  },
);

function AlertDialog(props: React.ComponentProps<typeof AlertDialogPrimitive.Root>) {
  return <AlertDialogPrimitive.Root data-slot="alert-dialog" {...props} />;
}

function AlertDialogTrigger(props: React.ComponentProps<typeof AlertDialogPrimitive.Trigger>) {
