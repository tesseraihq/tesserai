"import * as React from "react";
import { Avatar as AvatarPrimitive } from "@base-ui/react/avatar";
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";

const avatarVariants = cva(
  "group/avatar relative flex shrink-0 select-none after:absolute after:inset-0 after:mix-blend-darken dark:after:mix-blend-lighten rounded-(--avatar-radius) after:border-neutral-border after:border-(length:--border-width) after:rounded-(--avatar-radius) *:data-[slot=avatar-fallback]:bg-neutral-subtle *:data-[slot=avatar-fallback]:text-neutral-text *:data-[slot=avatar-fallback]:rounded-(--avatar-radius)",
  {
    variants: {
      size: {
        sm: "size-(--avatar-size-sm) *:data-[slot=avatar-fallback]:text-1",
        md: "size-(--avatar-size-md) *:data-[slot=avatar-fallback]:text-2",
        lg: "size-(--avatar-size-lg) *:data-[slot=avatar-fallback]:text-2",
      },
    },
    compoundVariants: [],
    defaultVariants: { size: "md" },
  },
);

type Size = "sm" | "md" | "lg";

function resolveSize(size: Size | "default"): Size {
  return size === "default" ? "md" : size;
}

function Avatar({
  className,
  size = "default",
  ...props
}: Omit<React.ComponentProps<typeof AvatarPrimitive.Root>, "className"> & { className?: string } & {
  size?: Size | "default";
}) {
  const resolved = resolveSize(size);
  return (
    <AvatarPrimitive.Root
      data-slot="avatar"
      data-size={resolved}
      className={cn(avatarVariants({ size: resolved }), className)}
      {...props}
    />
  );
}

function AvatarImage({
  className,
  ...props
}: Omit<React.ComponentProps<typeof AvatarPrimitive.Image>, "className"> & { className?: string }) {
  return (
    <AvatarPrimitive.Image
      data-slot="avatar-image"
      className={cn("aspect-square size-full object-cover rounded-(--avatar-radius)", className)}
      {...props}
    />
  );
}

// Shown until the picture loads, or instead of it: initials, an icon.
function AvatarFallback({
  className,
  ...props
}: Omit<React.ComponentProps<typeof AvatarPrimitive.Fallback>, "className"> & {
  className?: string;
}) {
  return (
    <AvatarPrimitive.Fallback
      data-slot="avatar-fallback"
      className={cn("flex size-full items-center justify-center-safe overflow-hidden", className)}
      {...props}
    />
  );
}

// A dot at the bottom corner: online status, a count.
function AvatarBadge({ className, ...props }: React.ComponentProps<"span">) {
  return (
    <span
      data-slot="avatar-badge"
      className={cn(
        "absolute end-0 bottom-0 z-10 inline-flex items-center justify-center select-none group-data-[size=sm]/avatar:size-2 group-data-[size=sm]/avatar:[&>svg]:hidden size-2.5 [&>svg]:size-2 group-data-[size=lg]/avatar:size-3 bg-primary-solid text-primary-solid-foreground ring-(color:--surface-page) ring-(length:--avatar-ring-width) rounded-full",
        className,
      )}
      {...props}
    />
  );
}

function AvatarGroup({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="avatar-group"
      className={cn(
        "group/avatar-group flex -space-x-2 *:data-[slot=avatar]:ring-(color:--surface-page) *:data-[slot=avatar]:ring-(length:--avatar-ring-width)",
        className,
      )}
      {...props}
    />
  );
}

// "+3": how many more are in the group.
function AvatarGroupCount({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="avatar-group-count"
      className={cn(
        "relative flex shrink-0 items-center justify-center [&>svg]:size-4 group-has-data-[size=sm]/avatar-group:size-(--avatar-size-sm) size-(--avatar-size-md) group-has-data-[size=lg]/avatar-group:size-(--avatar-size-lg) bg-neutral-subtle text-neutral-text ring-(color:--surface-page) ring-(length:--avatar-ring-width) rounded-(--avatar-radius) text-2",
        className,
      )}
      {...props}
    />
  );
}

export { Avatar, AvatarImage, AvatarFallback, AvatarGroup, AvatarGroupCount, AvatarBadge };
"
`;

