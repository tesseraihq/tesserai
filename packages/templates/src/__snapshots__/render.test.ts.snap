"import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const inputVariants = cva(
  "flex w-full min-w-0 outline-none transition-[color,background-color,border-color,box-shadow] file:inline-flex file:h-full file:border-0 file:bg-transparent file:font-medium file:text-current bg-neutral-background text-neutral-text-strong border-neutral-border-strong border-(length:--border-width) rounded-(--input-radius) px-(--input-padding-x) text-(length:--input-font-size) duration-(--duration-fast) ease-standard hover:border-neutral-text focus-visible:border-primary-border-strong focus-visible:ring-primary-focus-ring focus-visible:ring-(length:--focus-width) focus-visible:ring-offset-(length:--focus-offset) focus-visible:ring-offset-(color:--surface-page) disabled:opacity-(--opacity-disabled) disabled:cursor-not-allowed aria-invalid:border-danger-border-strong aria-invalid:ring-danger-focus-ring read-only:bg-neutral-subtle placeholder:text-neutral-text",
  {
    variants: {
      size: {
        sm: "h-(--input-height-sm)",
        md: "h-(--input-height-md)",
        lg: "h-(--input-height-lg)",
      },
    },
    compoundVariants: [],
    defaultVariants: { size: "md" },
  },
);

// The native size attribute (a character count) is replaced by the design system's size axis.
export type InputProps = Omit<React.ComponentProps<"input">, "size"> & {
  size?: "sm" | "md" | "lg";
};

function Input({ className, size = "md", ...props }: InputProps) {
  return (
    <input
      data-slot="input"
      data-size={size}
      className={cn(inputVariants({ size }), className)}
      {...props}
    />
  );
}

export { Input, inputVariants };
export type InputVariants = VariantProps<typeof inputVariants>;
"
`;

