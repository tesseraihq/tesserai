            data-slot="slider-range"
            className="select-none data-[orientation=horizontal]:h-full data-[orientation=vertical]:w-full bg-primary-solid"
          />
        </SliderPrimitive.Track>
        {Array.from({ length: values.length }, (_, index) => (
          <SliderPrimitive.Thumb
            key={index}
            index={index}
            data-slot="slider-thumb"
            className="block shrink-0 select-none outline-none transition-[color,box-shadow] bg-neutral-background border-primary-border-strong border-(length:--border-width) shadow-sm rounded-(--slider-radius) size-(--slider-thumb-size) duration-(--duration-fast) ease-standard hover:scale-(--slider-thumb-active-scale) has-[:focus-visible]:ring-primary-focus-ring has-[:focus-visible]:ring-(length:--focus-width) has-[:focus-visible]:ring-offset-(length:--focus-offset) has-[:focus-visible]:ring-offset-(color:--surface-page) data-disabled:opacity-(--opacity-disabled) data-disabled:cursor-not-allowed data-dragging:scale-(--slider-thumb-active-scale)"
            {...(label === undefined ? {} : { getAriaLabel: () => label })}
          />
        ))}
      </SliderPrimitive.Control>
    </SliderPrimitive.Root>
