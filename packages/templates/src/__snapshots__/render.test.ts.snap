""use client";

import * as React from "react";
import { Slider as SliderPrimitive } from "radix-ui";
import { cn } from "@/lib/utils";

// The label given to the slider is also given to each thumb, since the thumb is what gets focus.
function Slider({
  className,
  defaultValue,
  value,
  min = 0,
  max = 100,
  ...props
}: React.ComponentProps<typeof SliderPrimitive.Root>) {
  const label = props["aria-label"];
  const labelledBy = props["aria-labelledby"];
  const values = React.useMemo(
    () => (Array.isArray(value) ? value : Array.isArray(defaultValue) ? defaultValue : [min, max]),
    [value, defaultValue, min, max],
  );
  return (
    <SliderPrimitive.Root
      data-slot="slider"
      {...(defaultValue === undefined ? {} : { defaultValue })}
      {...(value === undefined ? {} : { value })}
      min={min}
      max={max}
      className={cn(
        "relative flex w-full touch-none items-center select-none data-[orientation=vertical]:h-full data-[orientation=vertical]:w-auto data-[orientation=vertical]:flex-col",
        "data-[orientation=horizontal]:w-full data-[orientation=vertical]:h-full data-[disabled]:opacity-(--opacity-disabled) data-[orientation=vertical]:min-h-(--slider-vertical-min-height)",
        className,
      )}
      {...props}
    >
      <SliderPrimitive.Track
        data-slot="slider-track"
        className="relative grow overflow-hidden select-none data-[orientation=horizontal]:w-full data-[orientation=vertical]:h-full bg-neutral-subtle rounded-(--slider-radius) data-[orientation=horizontal]:h-(--slider-track-thickness) data-[orientation=vertical]:w-(--slider-track-thickness)"
      >
        <SliderPrimitive.Range
          data-slot="slider-range"
          className="absolute select-none data-[orientation=horizontal]:h-full data-[orientation=vertical]:w-full bg-primary-solid"
        />
      </SliderPrimitive.Track>
      {Array.from({ length: values.length }, (_, index) => (
        <SliderPrimitive.Thumb
          key={index}
          data-slot="slider-thumb"
          className="block shrink-0 select-none outline-none transition-[color,box-shadow] bg-neutral-background border-primary-border-strong border-(length:--border-width) shadow-sm rounded-(--slider-radius) size-(--slider-thumb-size) duration-(--duration-fast) ease-standard hover:scale-(--slider-thumb-active-scale) focus-visible:ring-primary-focus-ring focus-visible:ring-(length:--focus-width) focus-visible:ring-offset-(length:--focus-offset) focus-visible:ring-offset-(color:--surface-page) data-[disabled]:opacity-(--opacity-disabled) data-[disabled]:cursor-not-allowed active:scale-(--slider-thumb-active-scale)"
          {...(label === undefined ? {} : { "aria-label": label })}
          {...(labelledBy === undefined ? {} : { "aria-labelledby": labelledBy })}
        />
      ))}
    </SliderPrimitive.Root>
  );
}

export { Slider };
"
