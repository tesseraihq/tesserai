        className,
      )}
      {...props}
    />
  );
}

// Appears when you have scrolled away from the newest (or oldest) message.
function MessageScrollerButton({
  direction = "end",
  className,
  children,
  render,
  variant = "outline",
  size = "icon-sm",
  ...props
}: React.ComponentProps<typeof MessageScrollerPrimitive.Button> &
