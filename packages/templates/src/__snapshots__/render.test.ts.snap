      { variant: "link", intent: "info", class: "text-info-text" },
    ],
    defaultVariants: { variant: "soft", intent: "neutral", size: "md" },
  },
);

type Variant = "solid" | "soft" | "outline" | "ghost" | "link";
type Intent = "primary" | "neutral" | "danger" | "warning" | "success" | "info";

const aliases = {
  default: { variant: "solid", intent: "primary" },
  secondary: { variant: "soft", intent: "neutral" },
  destructive: { variant: "solid", intent: "danger" },
} as const satisfies Record<string, { variant: Variant; intent: Intent }>;
type Alias = keyof typeof aliases;

// A variant chosen without an intent takes the intent shadcn gives that variant.
const defaultIntent: Record<Variant, Intent> = {
  solid: "primary",
  soft: "neutral",
  outline: "neutral",
  ghost: "neutral",
  link: "primary",
};

export type BadgeProps = React.ComponentProps<"span"> & { asChild?: boolean } & {
  variant?: Variant | Alias | undefined;
  intent?: Intent | undefined;
  size?: "sm" | "md" | undefined;
};

function resolveAxes(variant: Variant | Alias, intent: Intent | undefined) {
  if (variant in aliases) {
    const alias = aliases[variant as Alias];
    return { variant: alias.variant, intent: intent ?? alias.intent };
  }
  return { variant: variant as Variant, intent: intent ?? defaultIntent[variant as Variant] };
}

// Text goes in a span, which ends in an ellipsis when the control has no room for it; text set
// straight in the control can't be shortened.
function label<T>(children: T): T {
  const wrap = (child: unknown) =>
    typeof child === "number" || (typeof child === "string" && child.trim() !== "") ? (
      <span>{child}</span>
    ) : (
      child
    );
  return (Array.isArray(children) ? React.Children.map(children, wrap) : wrap(children)) as T;
}

function Badge({
  className,
  variant = "soft",
  intent,
  size = "md",
  asChild = false,
  children,
  ...props
}: BadgeProps) {
  const axes = resolveAxes(variant, intent);
  const Comp = asChild ? Slot.Root : "span";
  return (
    <Comp
      className={cn(badgeVariants({ ...axes, size }), className)}
      {...{
        "data-slot": "badge",
        "data-variant": axes.variant,
        "data-intent": axes.intent,
        "data-size": size,
      }}
      {...props}
    >
      {label(children)}
    </Comp>
  );
}

export { Badge, badgeVariants };
export type BadgeVariants = VariantProps<typeof badgeVariants>;
"
`;

