    <div
      data-slot="bubble-group"
      className={cn("flex min-w-0 flex-col gap-(--space-3)", className)}
      {...props}
    />
  );
}

const bubbleVariants = cva(
  "group/bubble relative flex w-fit max-w-[80%] min-w-0 flex-col gap-1 data-[align=end]:self-end group-data-[align=end]/message:self-end data-[variant=ghost]:max-w-full *:data-[slot=bubble-reactions]:bg-neutral-subtle *:data-[slot=bubble-reactions]:ring-(color:--surface-card) *:data-[slot=bubble-reactions]:ring-(length:--focus-width) *:data-[slot=bubble-reactions]:rounded-full *:data-[slot=bubble-reactions]:px-(--space-2) *:data-[slot=bubble-reactions]:gap-(--space-2) *:data-[slot=bubble-reactions]:text-2 *:data-[slot=bubble-content]:border-(length:--border-width) *:data-[slot=bubble-content]:rounded-xl *:data-[slot=bubble-content]:px-(--space-4) *:data-[slot=bubble-content]:py-(--space-3) *:data-[slot=bubble-content]:text-2",
  {
    variants: {
      variant: {
        solid: "",
        soft: "",
        outline: "*:data-[slot=bubble-content]:bg-(color:--surface-page)",
        ghost: "*:data-[slot=bubble-content]:border-(color:--surface-page)",
      },
      intent: {
        primary: "",
        neutral: "",
        danger: "",
        warning: "",
        success: "",
        info: "",
      },
    },
    compoundVariants: [
      {
        variant: "solid",
        intent: "primary",
        class:
          "*:data-[slot=bubble-content]:bg-primary-solid *:data-[slot=bubble-content]:text-primary-solid-foreground *:data-[slot=bubble-content]:border-primary-solid *:data-[slot=bubble-content]:[&:is(button,a)]:hover:bg-primary-solid-hover",
      },
      {
        variant: "solid",
        intent: "neutral",
        class:
          "*:data-[slot=bubble-content]:bg-neutral-solid *:data-[slot=bubble-content]:text-neutral-solid-foreground *:data-[slot=bubble-content]:border-neutral-solid *:data-[slot=bubble-content]:[&:is(button,a)]:hover:bg-neutral-solid-hover",
      },
      {
        variant: "solid",
        intent: "danger",
        class:
          "*:data-[slot=bubble-content]:bg-danger-solid *:data-[slot=bubble-content]:text-danger-solid-foreground *:data-[slot=bubble-content]:border-danger-solid *:data-[slot=bubble-content]:[&:is(button,a)]:hover:bg-danger-solid-hover",
      },
      {
        variant: "solid",
