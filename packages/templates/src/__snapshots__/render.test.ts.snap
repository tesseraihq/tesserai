        md: "size-(--switch-thumb-size-md) data-checked:translate-x-[calc(var(--switch-width-md)-var(--switch-thumb-size-md)-2*var(--switch-inset)-2*var(--border-width))] rtl:data-checked:-translate-x-[calc(var(--switch-width-md)-var(--switch-thumb-size-md)-2*var(--switch-inset)-2*var(--border-width))]",
