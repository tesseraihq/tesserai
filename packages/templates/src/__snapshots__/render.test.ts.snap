"import * as React from "react";
import { ScrollArea as ScrollAreaPrimitive } from "@base-ui/react/scroll-area";
import { cn } from "@/lib/utils";

function ScrollArea({
  className,
  children,
  ...props
}: Omit<React.ComponentProps<typeof ScrollAreaPrimitive.Root>, "className"> & {
  className?: string;
}) {
  return (
    <ScrollAreaPrimitive.Root
      data-slot="scroll-area"
      className={cn("relative", className)}
      {...props}
    >
      {/* Focusable so the keyboard can scroll it (Base UI's viewport already is). */}
      <ScrollAreaPrimitive.Viewport
        data-slot="scroll-area-viewport"
        className="size-full wrap-anywhere outline-none transition-[color,box-shadow] rounded-md focus-visible:ring-primary-focus-ring focus-visible:ring-(length:--focus-width) focus-visible:ring-offset-(length:--focus-offset) focus-visible:ring-offset-(color:--surface-page)"
      >
        {children}
      </ScrollAreaPrimitive.Viewport>
      <ScrollBar />
      <ScrollAreaPrimitive.Corner />
    </ScrollAreaPrimitive.Root>
  );
}

// A vertical bar comes with every ScrollArea; add <ScrollBar orientation="horizontal" /> to scroll sideways.
function ScrollBar({
  className,
  orientation = "vertical",
  ...props
}: Omit<React.ComponentProps<typeof ScrollAreaPrimitive.Scrollbar>, "className"> & {
  className?: string;
}) {
  return (
    <ScrollAreaPrimitive.Scrollbar
      data-slot="scroll-area-scrollbar"
      data-orientation={orientation}
      orientation={orientation}
      className={cn(
        "flex touch-none select-none transition-colors p-(--border-width) data-[orientation=vertical]:w-(--scroll-area-scrollbar-size) data-[orientation=vertical]:h-full data-[orientation=horizontal]:h-(--scroll-area-scrollbar-size) data-[orientation=horizontal]:flex-col",
        className,
      )}
      {...props}
    >
      <ScrollAreaPrimitive.Thumb
        data-slot="scroll-area-thumb"
        className="relative flex-1 bg-neutral-border rounded-full"
      />
    </ScrollAreaPrimitive.Scrollbar>
  );
}

export { ScrollArea, ScrollBar };
"
`;

