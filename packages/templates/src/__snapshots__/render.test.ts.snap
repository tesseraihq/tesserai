""use client";

import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const alertVariants = cva(
  "group/alert relative grid w-full text-start has-[>svg]:grid-cols-[auto_1fr] *:[svg]:row-span-2 *:[svg]:translate-y-0.5 has-data-[slot=alert-action]:pe-18 rounded-(--alert-radius) px-(--alert-padding-x) py-(--alert-padding-y) gap-(--space-4) text-2 *:[svg]:size-(--alert-icon-size) *:data-[slot=alert-title]:font-medium gap-y-0.5",
  {
    variants: {
      variant: {
        outline: "bg-(color:--surface-card) border-(length:--border-width)",
        soft: "",
      },
      intent: {
        primary:
          "text-primary-text-strong *:[svg]:text-primary-text *:data-[slot=alert-description]:text-primary-text",
        neutral:
          "text-neutral-text-strong *:[svg]:text-neutral-text *:data-[slot=alert-description]:text-neutral-text",
        danger:
          "text-danger-text-strong *:[svg]:text-danger-text *:data-[slot=alert-description]:text-danger-text",
        warning:
          "text-warning-text-strong *:[svg]:text-warning-text *:data-[slot=alert-description]:text-warning-text",
        success:
          "text-success-text-strong *:[svg]:text-success-text *:data-[slot=alert-description]:text-success-text",
        info: "text-info-text-strong *:[svg]:text-info-text *:data-[slot=alert-description]:text-info-text",
      },
    },
    compoundVariants: [
      { variant: "outline", intent: "primary", class: "border-primary-border" },
      { variant: "outline", intent: "neutral", class: "border-neutral-border" },
      { variant: "outline", intent: "danger", class: "border-danger-border" },
      { variant: "outline", intent: "warning", class: "border-warning-border" },
      { variant: "outline", intent: "success", class: "border-success-border" },
      { variant: "outline", intent: "info", class: "border-info-border" },
      { variant: "soft", intent: "primary", class: "bg-primary-subtle" },
      { variant: "soft", intent: "neutral", class: "bg-neutral-subtle" },
      { variant: "soft", intent: "danger", class: "bg-danger-subtle" },
      { variant: "soft", intent: "warning", class: "bg-warning-subtle" },
      { variant: "soft", intent: "success", class: "bg-success-subtle" },
      { variant: "soft", intent: "info", class: "bg-info-subtle" },
    ],
    defaultVariants: { variant: "outline", intent: "neutral" },
  },
);

type Variant = "outline" | "soft";
type Intent = "primary" | "neutral" | "danger" | "warning" | "success" | "info";

// shadcn's names keep working.
const aliases = {
  default: { variant: "outline", intent: "neutral" },
  destructive: { variant: "outline", intent: "danger" },
} as const satisfies Record<string, { variant: Variant; intent: Intent }>;
type Alias = keyof typeof aliases;

function resolveAxes(variant: Variant | Alias | undefined, intent: Intent | undefined) {
  if (variant !== undefined && variant in aliases) {
    const alias = aliases[variant as Alias];
    return { variant: alias.variant, intent: intent ?? alias.intent };
  }
  return { variant: (variant as Variant | undefined) ?? "outline", intent: intent ?? "neutral" };
}

function Alert({
  className,
  variant,
  intent,
  ...props
}: React.ComponentProps<"div"> & {
  variant?: Variant | Alias | undefined;
  intent?: Intent | undefined;
}) {
  const axes = resolveAxes(variant, intent);
  return (
    <div
      data-slot="alert"
      role="alert"
      data-variant={axes.variant}
      data-intent={axes.intent}
      className={cn(alertVariants(axes), className)}
      {...props}
    />
  );
}

function AlertTitle({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="alert-title"
      className={cn(
        "group-has-[>svg]/alert:col-start-2 [&_a]:underline [&_a]:underline-offset-3",
        className,
      )}
      {...props}
    />
  );
}

function AlertDescription({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="alert-description"
      className={cn(
        "group-has-[>svg]/alert:col-start-2 text-balance md:text-pretty [&_a]:underline [&_a]:underline-offset-3 [&_p:not(:last-child)]:mb-4",
        className,
      )}
      {...props}
    />
  );
}

function AlertAction({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div data-slot="alert-action" className={cn("absolute top-2.5 end-3", className)} {...props} />
  );
}

export { Alert, AlertTitle, AlertDescription, AlertAction, alertVariants };
export type AlertVariants = VariantProps<typeof alertVariants>;
"
`;

exports[`renderAll > renders the same component set on React Aria, in React Aria's idioms 41`] = `
""use client";

import * as React from "react";
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";

const avatarVariants = cva(
  "group/avatar relative flex shrink-0 select-none after:absolute after:inset-0 after:mix-blend-darken dark:after:mix-blend-lighten rounded-(--avatar-radius) after:border-neutral-border after:border-(length:--border-width) after:rounded-(--avatar-radius) *:data-[slot=avatar-fallback]:bg-neutral-subtle *:data-[slot=avatar-fallback]:text-neutral-text *:data-[slot=avatar-fallback]:rounded-(--avatar-radius)",
  {
    variants: {
      size: {
        sm: "size-(--avatar-size-sm) *:data-[slot=avatar-fallback]:text-1",
        md: "size-(--avatar-size-md) *:data-[slot=avatar-fallback]:text-2",
        lg: "size-(--avatar-size-lg) *:data-[slot=avatar-fallback]:text-2",
      },
    },
    compoundVariants: [],
    defaultVariants: { size: "md" },
  },
);

type Size = "sm" | "md" | "lg";

function resolveSize(size: Size | "default"): Size {
  return size === "default" ? "md" : size;
}

function Avatar({
  className,
  size = "default",
  ...props
}: React.ComponentProps<"div"> & { size?: Size | "default" }) {
  const resolved = resolveSize(size);
  return (
    <div
      data-slot="avatar"
      data-size={resolved}
      className={cn(avatarVariants({ size: resolved }), className)}
      {...props}
    />
  );
}

type ImageState = "loading" | "loaded" | "error";

// Hides itself if the picture fails, and the fallback after it shows instead.
function AvatarImage({ className, ...props }: React.ComponentProps<"img">) {
  const [state, setState] = React.useState<ImageState>(props.src ? "loading" : "error");
  return (
    <img
      data-slot="avatar-image"
      alt={props.alt ?? ""}
      data-state={state}
      onLoad={() => setState("loaded")}
      onError={() => setState("error")}
      className={cn(
        "peer data-[state=error]:hidden",
        "aspect-square size-full object-cover rounded-(--avatar-radius)",
        className,
      )}
      {...props}
    />
  );
}

function AvatarFallback({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="avatar-fallback"
      className={cn(
        "flex size-full items-center justify-center-safe overflow-hidden",
        "peer-[*]:hidden peer-data-[state=error]:flex",
        className,
      )}
      {...props}
    />
  );
}

// A dot at the bottom corner: online status, a count.
function AvatarBadge({ className, ...props }: React.ComponentProps<"span">) {
  return (
    <span
      data-slot="avatar-badge"
      className={cn(
        "absolute end-0 bottom-0 z-10 inline-flex items-center justify-center select-none group-data-[size=sm]/avatar:size-2 group-data-[size=sm]/avatar:[&>svg]:hidden size-2.5 [&>svg]:size-2 group-data-[size=lg]/avatar:size-3 bg-primary-solid text-primary-solid-foreground ring-(color:--surface-page) ring-(length:--avatar-ring-width) rounded-full",
        className,
      )}
      {...props}
    />
  );
}

function AvatarGroup({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="avatar-group"
      className={cn(
        "group/avatar-group flex -space-x-2 *:data-[slot=avatar]:ring-(color:--surface-page) *:data-[slot=avatar]:ring-(length:--avatar-ring-width)",
        className,
      )}
      {...props}
    />
  );
}

// "+3": how many more are in the group.
function AvatarGroupCount({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="avatar-group-count"
      className={cn(
        "relative flex shrink-0 items-center justify-center [&>svg]:size-4 group-has-data-[size=sm]/avatar-group:size-(--avatar-size-sm) size-(--avatar-size-md) group-has-data-[size=lg]/avatar-group:size-(--avatar-size-lg) bg-neutral-subtle text-neutral-text ring-(color:--surface-page) ring-(length:--avatar-ring-width) rounded-(--avatar-radius) text-2",
        className,
      )}
      {...props}
    />
  );
}

export { Avatar, AvatarImage, AvatarFallback, AvatarGroup, AvatarGroupCount, AvatarBadge };
"
`;

