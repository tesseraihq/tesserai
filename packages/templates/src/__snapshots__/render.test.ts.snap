"import * as React from "react";
import { Toggle as TogglePrimitive } from "@base-ui/react/toggle";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const toggleVariants = cva(
  "inline-flex items-center justify-center whitespace-nowrap min-w-0 max-w-full [&>span]:min-w-0 [&>span]:truncate outline-none transition-[color,background-color,border-color,box-shadow,opacity] [&_svg]:pointer-events-none [&_svg]:shrink-0 text-neutral-text-strong rounded-(--toggle-radius) px-(--toggle-padding-x) gap-(--toggle-gap) text-(length:--toggle-font-size) font-(--toggle-font-weight) duration-(--duration-fast) ease-standard cursor-pointer hover:bg-neutral-subtle focus-visible:ring-primary-focus-ring focus-visible:ring-(length:--focus-width) focus-visible:ring-offset-(length:--focus-offset) focus-visible:ring-offset-(color:--surface-page) data-disabled:opacity-(--opacity-disabled) data-disabled:cursor-not-allowed aria-invalid:border-danger-border-strong data-pressed:bg-neutral-subtle-hover [&_svg]:size-(--toggle-icon-size)",
  {
    variants: {
      variant: {
        ghost: "",
        outline: "border-neutral-border border-(length:--border-width)",
      },
      size: {
        sm: "h-(--toggle-height-sm) min-w-(--toggle-height-sm)",
        md: "h-(--toggle-height-md) min-w-(--toggle-height-md)",
        lg: "h-(--toggle-height-lg) min-w-(--toggle-height-lg)",
      },
    },
    compoundVariants: [],
    defaultVariants: { variant: "ghost", size: "md" },
  },
);

export type ToggleVariant = "ghost" | "outline";
export type ToggleSize = "sm" | "md" | "lg";

// shadcn calls the transparent toggle "default"; it maps to "ghost" here.
function toggleVariant(variant: ToggleVariant | "default" | undefined): ToggleVariant {
  return variant === undefined ? "ghost" : variant === "default" ? "ghost" : variant;
}

// Text goes in a span, which ends in an ellipsis when the control has no room for it; text set
// straight in the control can't be shortened.
function label<T>(children: T): T {
  const wrap = (child: unknown) =>
    typeof child === "number" || (typeof child === "string" && child.trim() !== "") ? (
      <span>{child}</span>
    ) : (
      child
    );
  return (Array.isArray(children) ? React.Children.map(children, wrap) : wrap(children)) as T;
}

export type ToggleProps = Omit<React.ComponentProps<typeof TogglePrimitive>, "className"> & {
  className?: string;
  variant?: ToggleVariant | "default";
  size?: ToggleSize;
};

function Toggle({ className, variant, size = "md", children, ...props }: ToggleProps) {
  const v = toggleVariant(variant);
  return (
    <TogglePrimitive
      data-slot="toggle"
      data-variant={v}
      data-size={size}
      className={cn(toggleVariants({ variant: v, size }), className)}
      {...props}
    >
      {label(children)}
    </TogglePrimitive>
  );
}

export { Toggle, toggleVariant, toggleVariants };
export type ToggleVariants = VariantProps<typeof toggleVariants>;
"
`;

