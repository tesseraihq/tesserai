"import { clsx, type ClassValue } from "clsx";
import { extendTailwindMerge, validators } from "tailwind-merge";

const twMerge = extendTailwindMerge({
  extend: { theme: { text: ["1", "2", "3", "4", "5", "6", "7", "8", "9"] }, classGroups: { "ring-offset-w": [{ "ring-offset": [validators.isArbitraryVariableLength] }] } },
});

export function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs));
}
"
`;

exports[`renderAll > renders the same component set on React Aria, in React Aria's idioms 2`] = `
""use client";

import * as React from "react";
import {
  Button as ButtonPrimitive,
  composeRenderProps,
  Link,
  type ButtonProps as ButtonPrimitiveProps,
  type LinkProps,
} from "react-aria-components";
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";

const variantClasses = cva(
  "inline-flex items-center justify-center whitespace-nowrap min-w-0 max-w-full [&>span]:min-w-0 [&>span]:truncate select-none outline-none transition-[color,background-color,border-color,box-shadow,opacity] [&_svg]:pointer-events-none [&_svg]:shrink-0 rounded-(--button-radius) gap-(--button-gap) font-(--button-font-weight) duration-(--duration-fast) ease-standard cursor-pointer data-focus-visible:ring-(length:--focus-width) data-focus-visible:ring-offset-(length:--focus-offset) data-focus-visible:ring-offset-(color:--surface-page) data-disabled:opacity-(--opacity-disabled) data-disabled:cursor-not-allowed",
  {
    variants: {
      variant: {
        solid: "",
        soft: "",
        outline: "border-(length:--border-width)",
        ghost: "",
        link: "no-underline data-hovered:underline",
      },
      intent: {
        primary: "data-focus-visible:ring-primary-focus-ring",
        neutral: "data-focus-visible:ring-neutral-focus-ring",
        danger: "data-focus-visible:ring-danger-focus-ring",
        warning: "data-focus-visible:ring-warning-focus-ring",
        success: "data-focus-visible:ring-success-focus-ring",
        info: "data-focus-visible:ring-info-focus-ring",
      },
      size: {
        xs: "px-(--button-padding-x-xs) h-(--button-height-xs) text-(length:--button-font-size-xs) [&_svg]:size-(--button-icon-size-xs)",
        sm: "px-(--button-padding-x-sm) h-(--button-height-sm) text-(length:--button-font-size-sm) [&_svg]:size-(--button-icon-size-sm)",
        md: "px-(--button-padding-x-md) h-(--button-height-md) text-(length:--button-font-size-md) [&_svg]:size-(--button-icon-size-md)",
        lg: "px-(--button-padding-x-lg) h-(--button-height-lg) text-(length:--button-font-size-lg) [&_svg]:size-(--button-icon-size-lg)",
      },
    },
    compoundVariants: [
      {
        variant: "solid",
        intent: "primary",
        class: "bg-primary-solid text-primary-solid-foreground data-hovered:bg-primary-solid-hover",
      },
      {
        variant: "solid",
        intent: "neutral",
        class: "bg-neutral-solid text-neutral-solid-foreground data-hovered:bg-neutral-solid-hover",
      },
      {
        variant: "solid",
        intent: "danger",
        class: "bg-danger-solid text-danger-solid-foreground data-hovered:bg-danger-solid-hover",
      },
      {
        variant: "solid",
        intent: "warning",
        class: "bg-warning-solid text-warning-solid-foreground data-hovered:bg-warning-solid-hover",
      },
      {
        variant: "solid",
        intent: "success",
        class: "bg-success-solid text-success-solid-foreground data-hovered:bg-success-solid-hover",
      },
      {
        variant: "solid",
        intent: "info",
        class: "bg-info-solid text-info-solid-foreground data-hovered:bg-info-solid-hover",
      },
      {
        variant: "soft",
        intent: "primary",
        class:
          "bg-primary-subtle text-primary-subtle-foreground data-hovered:bg-primary-subtle-hover",
      },
      {
        variant: "soft",
        intent: "neutral",
        class:
          "bg-neutral-subtle text-neutral-subtle-foreground data-hovered:bg-neutral-subtle-hover",
      },
      {
        variant: "soft",
        intent: "danger",
        class: "bg-danger-subtle text-danger-subtle-foreground data-hovered:bg-danger-subtle-hover",
      },
      {
        variant: "soft",
        intent: "warning",
        class:
          "bg-warning-subtle text-warning-subtle-foreground data-hovered:bg-warning-subtle-hover",
      },
      {
        variant: "soft",
        intent: "success",
        class:
          "bg-success-subtle text-success-subtle-foreground data-hovered:bg-success-subtle-hover",
      },
      {
        variant: "soft",
        intent: "info",
        class: "bg-info-subtle text-info-subtle-foreground data-hovered:bg-info-subtle-hover",
      },
      {
        variant: "outline",
        intent: "primary",
        class: "text-primary-text border-primary-border-strong data-hovered:bg-primary-subtle",
      },
      {
        variant: "outline",
        intent: "neutral",
        class: "text-neutral-text border-neutral-border-strong data-hovered:bg-neutral-subtle",
      },
      {
        variant: "outline",
        intent: "danger",
        class: "text-danger-text border-danger-border-strong data-hovered:bg-danger-subtle",
      },
      {
        variant: "outline",
        intent: "warning",
        class: "text-warning-text border-warning-border-strong data-hovered:bg-warning-subtle",
      },
      {
        variant: "outline",
        intent: "success",
        class: "text-success-text border-success-border-strong data-hovered:bg-success-subtle",
      },
      {
        variant: "outline",
        intent: "info",
        class: "text-info-text border-info-border-strong data-hovered:bg-info-subtle",
      },
      {
        variant: "ghost",
        intent: "primary",
        class: "text-primary-text data-hovered:bg-primary-subtle",
      },
      {
        variant: "ghost",
        intent: "neutral",
        class: "text-neutral-text data-hovered:bg-neutral-subtle",
      },
      {
        variant: "ghost",
        intent: "danger",
        class: "text-danger-text data-hovered:bg-danger-subtle",
      },
      {
        variant: "ghost",
        intent: "warning",
        class: "text-warning-text data-hovered:bg-warning-subtle",
      },
      {
        variant: "ghost",
        intent: "success",
        class: "text-success-text data-hovered:bg-success-subtle",
      },
      { variant: "ghost", intent: "info", class: "text-info-text data-hovered:bg-info-subtle" },
      { variant: "link", intent: "primary", class: "text-primary-text" },
      { variant: "link", intent: "neutral", class: "text-neutral-text" },
      { variant: "link", intent: "danger", class: "text-danger-text" },
      { variant: "link", intent: "warning", class: "text-warning-text" },
      { variant: "link", intent: "success", class: "text-success-text" },
      { variant: "link", intent: "info", class: "text-info-text" },
    ],
    defaultVariants: { variant: "solid", intent: "primary", size: "md" },
  },
);

type Variant = "solid" | "soft" | "outline" | "ghost" | "link";
type Intent = "primary" | "neutral" | "danger" | "warning" | "success" | "info";
type Size = "xs" | "sm" | "md" | "lg";

// shadcn variant names keep working; they map to a variant + intent pair.
const aliases = {
  default: { variant: "solid", intent: "primary" },
  destructive: { variant: "solid", intent: "danger" },
  secondary: { variant: "soft", intent: "neutral" },
  outline: { variant: "outline", intent: "neutral" },
  ghost: { variant: "ghost", intent: "neutral" },
  link: { variant: "link", intent: "primary" },
} as const satisfies Record<string, { variant: Variant; intent: Intent }>;
type Alias = keyof typeof aliases;

// A variant chosen without an intent takes the intent shadcn gives that variant.
const defaultIntent: Record<Variant, Intent> = {
  solid: "primary",
  soft: "neutral",
  outline: "neutral",
  ghost: "neutral",
  link: "primary",
};

// Icon-only buttons are the same heights made square; "icon" is the default height. Having no
// label to shorten, they don't shrink.
const iconSizes = {
  icon: "md",
  "icon-xs": "xs",
  "icon-sm": "sm",
  "icon-md": "md",
  "icon-lg": "lg",
} as const satisfies Record<string, Size>;
type SizeName = Size | "default" | keyof typeof iconSizes;

export type ButtonVariantProps = {
  variant?: Variant | Alias | undefined;
  intent?: Intent | undefined;
  size?: SizeName | undefined;
};

function isAlias(value: Variant | Alias): value is Alias {
  return value in aliases;
}

function resolveAxes({ variant, intent, size }: ButtonVariantProps) {
  const s = size === undefined || size === "default" ? "md" : size;
  const square = s in iconSizes;
  const height: Size = square ? iconSizes[s as keyof typeof iconSizes] : (s as Size);
  if (variant !== undefined && isAlias(variant)) {
    const alias = aliases[variant];
    return { variant: alias.variant, intent: intent ?? alias.intent, size: height, square };
  }
  const v: Variant = variant ?? "solid";
  return { variant: v, intent: intent ?? defaultIntent[v], size: height, square };
}

// Classes for anything that should look like a button, such as a link.
function buttonVariants({
  className,
  ...props
}: ButtonVariantProps & { className?: string | undefined } = {}) {
  const { square, ...axes } = resolveAxes(props);
  return cn(variantClasses(axes), square && "aspect-square shrink-0 px-0", className);
}

export type ButtonProps = ButtonPrimitiveProps & ButtonVariantProps;

// Text goes in a span, which ends in an ellipsis when the control has no room for it; text set
// straight in the control can't be shortened.
function label<T>(children: T): T {
  const wrap = (child: unknown) =>
    typeof child === "number" || (typeof child === "string" && child.trim() !== "") ? (
      <span>{child}</span>
    ) : (
      child
    );
  return (Array.isArray(children) ? React.Children.map(children, wrap) : wrap(children)) as T;
}

function Button({ className, variant, intent, size = "default", children, ...props }: ButtonProps) {
  const axes = resolveAxes({ variant, intent, size });
  return (
    <ButtonPrimitive
      data-slot="button"
      data-variant={axes.variant}
      data-intent={axes.intent}
      data-size={size === "default" ? axes.size : size}
      className={composeRenderProps(className, (className) =>
        buttonVariants({ variant, intent, size, className }),
      )}
      {...props}
    >
      {label(children)}
    </ButtonPrimitive>
  );
}

function LinkButton({
  className,
  variant,
  intent,
  size = "default",
  children,
  ...props
}: LinkProps & ButtonVariantProps) {
  const axes = resolveAxes({ variant, intent, size });
  return (
    <Link
      data-slot="button"
      data-variant={axes.variant}
      data-intent={axes.intent}
      data-size={size === "default" ? axes.size : size}
      className={composeRenderProps(className, (className) =>
        buttonVariants({ variant, intent, size, className }),
      )}
      {...props}
    >
      {label(children)}
    </Link>
  );
}

export { Button, LinkButton, buttonVariants };
"
`;

