      data-slot="questionnaire-progress"
      className={cn(
        "min-h-[1lh] w-fit min-w-[14ch] tabular-nums text-neutral-text text-1 font-medium",
        className,
      )}
      {...props}
    />
  );
}

function QuestionnaireItem({
