      data-slot="alert-dialog-overlay"
      className={cn(
        "fixed inset-0 z-50 data-[state=open]:animate-fade-in data-[state=closed]:animate-fade-out bg-(color:--surface-backdrop) duration-(--duration-base) ease-standard",
        className,
      )}
      {...props}
    />
  );
}

function AlertDialogContent({
  className,
  size = "md",
  ...props
}: React.ComponentProps<typeof AlertDialogPrimitive.Content> & { size?: "sm" | "md" }) {
  return (
    <AlertDialogPortal>
      <AlertDialogOverlay />
      <AlertDialogPrimitive.Content
        data-slot="alert-dialog-content"
        data-size={size}
        className={cn(alertDialogContentVariants({ size }), className)}
        {...props}
      />
    </AlertDialogPortal>
  );
}

function AlertDialogHeader({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="alert-dialog-header"
      className={cn("flex flex-col gap-(--space-2)", className)}
      {...props}
    />
  );
}

function AlertDialogFooter({ className, ...props }: React.ComponentProps<"div">) {
