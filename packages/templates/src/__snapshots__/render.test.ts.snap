      data-slot="field-label"
      className={cn(
        "flex w-fit items-center leading-snug text-neutral-text-strong text-(length:--field-font-size) font-medium group-data-[disabled=true]/field:opacity-(--opacity-disabled)",
        className,
      )}
      {...props}
    />
  );
}

function FieldDescription({ className, ...props }: React.ComponentProps<"p">) {
  return (
    <p
      data-slot="field-description"
      className={cn(
        "leading-normal font-normal text-start group-has-data-[orientation=horizontal]/field:text-balance last:mt-0 nth-last-2:-mt-1 [&>a]:underline [&>a]:underline-offset-4 text-neutral-text text-(length:--field-font-size)",
        className,
      )}
      {...props}
    />
  );
}

function FieldSeparator({
  children,
  className,
  ...props
}: React.ComponentProps<"div"> & { children?: React.ReactNode }) {
  return (
    <div
      data-slot="field-separator"
      data-content={children !== undefined && children !== null}
      className={cn("relative -my-2 h-5", className)}
      {...props}
    >
      <div aria-hidden="true" className={"absolute inset-x-0 top-1/2 h-px bg-neutral-border"} />
      {children !== undefined && children !== null ? (
        <span
          data-slot="field-separator-content"
          className={
            "relative mx-auto block w-fit max-w-full truncate bg-(color:--surface-page) text-neutral-text px-(--space-3) text-(length:--field-font-size)"
          }
        >
          {children}
        </span>
      ) : null}
    </div>
  );
}

function FieldError({
  className,
  children,
  errors,
  ...props
}: React.ComponentProps<"div"> & { errors?: Array<{ message?: string } | undefined> }) {
  const content = React.useMemo(() => {
    if (children !== undefined && children !== null) return children;
    if (errors === undefined || errors.length === 0) return null;
    const unique = [...new Map(errors.map((error) => [error?.message, error])).values()];
    if (unique.length === 1) return unique[0]?.message ?? null;
    return (
      <ul className="ms-4 flex list-disc flex-col gap-1">
        {unique.map((error, index) =>
          error?.message ? <li key={index}>{error.message}</li> : null,
        )}
      </ul>
    );
  }, [children, errors]);
  if (content === null || content === undefined) return null;
  return (
    <div
      role="alert"
      data-slot="field-error"
      className={cn("font-normal text-danger-text text-(length:--field-font-size)", className)}
      {...props}
    >
      {content}
    </div>
  );
}

export {
  Field,
  FieldContent,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
  FieldLegend,
  FieldSeparator,
  FieldSet,
  FieldTitle,
};
"
`;

exports[`renderAll > renders the same component set on React Aria, in React Aria's idioms 23`] = `
""use client";

import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import {
  Button as ButtonPrimitive,
  Group,
  Input as InputPrimitive,
  TextArea as TextAreaPrimitive,
  type ButtonProps,
  type GroupProps,
  type InputProps,
  type TextAreaProps,
} from "react-aria-components";
import { cn } from "@/lib/utils";

function InputGroup({
  className,
  ...props
}: Omit<GroupProps, "className"> & { className?: string }) {
  return (
    <Group
      data-slot="input-group"
      className={cn(
        "group/input-group relative flex w-full min-w-0 items-center outline-none transition-[color,background-color,border-color,box-shadow,opacity] has-[>textarea]:h-auto has-[>[data-align=block-start]]:flex-col has-[>[data-align=block-end]]:flex-col has-[>[data-align=block-start]]:h-auto has-[>[data-align=block-end]]:h-auto bg-neutral-background border-neutral-border-strong border-(length:--border-width) rounded-(--input-group-radius) min-h-(--input-group-height) duration-(--duration-fast) ease-standard hover:border-neutral-text has-[[data-slot=input-group-control]:focus-visible]:border-primary-border-strong has-[[data-slot=input-group-control]:focus-visible]:ring-primary-focus-ring has-[[data-slot=input-group-control]:focus-visible]:ring-(length:--focus-width) has-[[data-slot=input-group-control]:focus-visible]:ring-offset-(length:--focus-offset) has-[[data-slot=input-group-control]:focus-visible]:ring-offset-(color:--surface-page) data-[disabled=true]:opacity-(--opacity-disabled) data-[disabled=true]:cursor-not-allowed has-[[data-slot][aria-invalid=true]]:border-danger-border-strong has-[[data-slot][aria-invalid=true]]:ring-danger-focus-ring",
        className,
      )}
      {...props}
    />
  );
}

const inputGroupAddonVariants = cva(
  "flex min-w-0 h-auto cursor-text items-center justify-center select-none [&>svg]:size-4 [&>svg]:shrink-0 group-data-[disabled=true]/input-group:opacity-50 text-neutral-text px-(--input-group-addon-padding-x) gap-(--input-group-addon-gap) text-(length:--input-group-font-size) font-medium",
  {
    variants: {
      align: {
        "inline-start": "order-first",
        "inline-end": "order-last",
        "block-start": "order-first w-full justify-start pt-2",
        "block-end": "order-last w-full justify-start pb-2",
      },
    },
    defaultVariants: { align: "inline-start" },
  },
);

// Clicking an addon (outside a button in it) focuses the control, as clicking a label would.
function InputGroupAddon({
  className,
  align = "inline-start",
  ...props
}: React.ComponentProps<"div"> & VariantProps<typeof inputGroupAddonVariants>) {
  return (
    <div
      role="group"
      data-slot="input-group-addon"
      data-align={align}
      className={cn(inputGroupAddonVariants({ align }), className)}
      onClick={(event) => {
        if (event.target instanceof Element && event.target.closest("button") !== null) return;
        const control = event.currentTarget.parentElement?.querySelector("input, textarea");
        if (control instanceof HTMLElement) control.focus();
      }}
      {...props}
    />
  );
}

const inputGroupButtonVariants = cva(
  "flex min-w-0 max-w-full items-center justify-center gap-1 whitespace-nowrap [&>span]:min-w-0 [&>span]:truncate outline-none [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:size-3.5 text-neutral-text-strong rounded-(--input-group-button-radius) px-(--input-group-button-padding-x) text-(length:--input-group-font-size) duration-(--duration-fast) ease-standard cursor-pointer data-hovered:bg-neutral-subtle data-focus-visible:ring-primary-focus-ring data-focus-visible:ring-(length:--focus-width) data-focus-visible:ring-offset-(length:--focus-offset) data-focus-visible:ring-offset-(color:--surface-page) data-disabled:opacity-(--opacity-disabled) data-disabled:cursor-not-allowed",
  {
    variants: {
      size: {
        xs: "h-[var(--input-group-button-xs)]",
        sm: "h-[var(--input-group-button-sm)]",
        "icon-xs": "size-[var(--input-group-button-xs)] shrink-0 px-0",
        "icon-sm": "size-[var(--input-group-button-sm)] shrink-0 px-0",
      },
    },
    defaultVariants: { size: "xs" },
  },
);

// Text goes in a span, which ends in an ellipsis when the control has no room for it; text set
// straight in the control can't be shortened.
function label<T>(children: T): T {
  const wrap = (child: unknown) =>
    typeof child === "number" || (typeof child === "string" && child.trim() !== "") ? (
      <span>{child}</span>
    ) : (
      child
    );
  return (Array.isArray(children) ? React.Children.map(children, wrap) : wrap(children)) as T;
}

function InputGroupButton({
  className,
  size = "xs",
  type = "button",
  children,
  ...props
}: Omit<ButtonProps, "className"> & { className?: string } & VariantProps<
    typeof inputGroupButtonVariants
  > & { type?: "button" | "submit" | "reset" }) {
  return (
    <ButtonPrimitive
      type={type}
      data-slot="input-group-button"
      data-size={size}
      className={cn(inputGroupButtonVariants({ size }), className)}
      {...props}
    >
      {label(children)}
    </ButtonPrimitive>
  );
}

function InputGroupText({ className, ...props }: React.ComponentProps<"span">) {
  return (
    <span
      className={cn("flex items-center gap-2 [&_svg]:pointer-events-none", className)}
      {...props}
    />
  );
}

function InputGroupInput({
  className,
  ...props
}: Omit<InputProps, "className"> & { className?: string }) {
  return (
    <InputPrimitive
      data-slot="input-group-control"
      className={cn(
        "flex-1 min-w-0 self-stretch bg-transparent outline-none border-0 shadow-none text-neutral-text-strong px-(--input-group-padding-x) text-(length:--input-group-font-size) placeholder:text-neutral-text group-has-[>[data-align=inline-start]]/input-group:ps-1 group-has-[>[data-align=inline-end]]/input-group:pe-1",
        className,
      )}
      {...props}
    />
  );
}

function InputGroupTextarea({
  className,
  ...props
}: Omit<TextAreaProps, "className"> & { className?: string }) {
  return (
    <TextAreaPrimitive
      data-slot="input-group-control"
      className={cn(
        "flex-1 min-w-0 self-stretch bg-transparent outline-none border-0 shadow-none text-neutral-text-strong px-(--input-group-padding-x) text-(length:--input-group-font-size) placeholder:text-neutral-text group-has-[>[data-align=inline-start]]/input-group:ps-1 group-has-[>[data-align=inline-end]]/input-group:pe-1",
        "resize-none py-2",
        className,
      )}
      {...props}
    />
  );
}

export {
  InputGroup,
  InputGroupAddon,
  InputGroupButton,
  InputGroupInput,
  InputGroupText,
  InputGroupTextarea,
};
"
`;

