}

const bubbleVariants = cva(
  "group/bubble relative flex w-fit max-w-[80%] min-w-0 flex-col gap-1 data-[align=end]:self-end group-data-[align=end]/message:self-end data-[variant=ghost]:max-w-full *:data-[slot=bubble-reactions]:bg-neutral-subtle *:data-[slot=bubble-reactions]:ring-(color:--surface-card) *:data-[slot=bubble-reactions]:ring-(length:--focus-width) *:data-[slot=bubble-reactions]:rounded-full *:data-[slot=bubble-reactions]:px-(--space-2) *:data-[slot=bubble-reactions]:gap-(--space-2) *:data-[slot=bubble-reactions]:text-2 *:data-[slot=bubble-content]:border-(length:--border-width) *:data-[slot=bubble-content]:rounded-xl *:data-[slot=bubble-content]:px-(--space-4) *:data-[slot=bubble-content]:py-(--space-3) *:data-[slot=bubble-content]:text-2",
