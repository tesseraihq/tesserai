      { variant: "outline", intent: "neutral", class: "border-neutral-border" },
      { variant: "outline", intent: "danger", class: "border-danger-border" },
      { variant: "outline", intent: "warning", class: "border-warning-border" },
      { variant: "outline", intent: "success", class: "border-success-border" },
      { variant: "outline", intent: "info", class: "border-info-border" },
      { variant: "soft", intent: "primary", class: "bg-primary-subtle" },
      { variant: "soft", intent: "neutral", class: "bg-neutral-subtle" },
      { variant: "soft", intent: "danger", class: "bg-danger-subtle" },
      { variant: "soft", intent: "warning", class: "bg-warning-subtle" },
      { variant: "soft", intent: "success", class: "bg-success-subtle" },
      { variant: "soft", intent: "info", class: "bg-info-subtle" },
    ],
    defaultVariants: { variant: "outline", intent: "neutral" },
  },
);

type Variant = "outline" | "soft";
type Intent = "primary" | "neutral" | "danger" | "warning" | "success" | "info";

// shadcn's names keep working.
const aliases = {
  default: { variant: "outline", intent: "neutral" },
  destructive: { variant: "outline", intent: "danger" },
} as const satisfies Record<string, { variant: Variant; intent: Intent }>;
type Alias = keyof typeof aliases;

function resolveAxes(variant: Variant | Alias | undefined, intent: Intent | undefined) {
  if (variant !== undefined && variant in aliases) {
    const alias = aliases[variant as Alias];
    return { variant: alias.variant, intent: intent ?? alias.intent };
  }
  return { variant: (variant as Variant | undefined) ?? "outline", intent: intent ?? "neutral" };
}

function Alert({
  className,
  variant,
  intent,
  ...props
}: React.ComponentProps<"div"> & {
  variant?: Variant | Alias | undefined;
  intent?: Intent | undefined;
}) {
