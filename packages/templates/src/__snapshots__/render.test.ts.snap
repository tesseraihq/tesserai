exports[`renderAll > renders the same component set on Radix, from the radix-ui package 50`] = `
""use client";

import * as React from "react";
import { Slot } from "radix-ui";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

// A group is a list, so the items in it are list items.
const ItemGroupContext = React.createContext(false);

function ItemGroup({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <ItemGroupContext value={true}>
      <div
        role="list"
        data-slot="item-group"
        className={cn("group/item-group flex w-full flex-col gap-(--space-4)", className)}
        {...props}
      />
    </ItemGroupContext>
  );
}

// Decorative: it sits between list items, where only items belong.
function ItemSeparator({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      role="none"
      data-orientation="horizontal"
      data-slot="item-separator"
      className={cn(
        "my-2",
        "shrink-0 bg-neutral-border data-[orientation=horizontal]:h-(--border-width) data-[orientation=horizontal]:w-full data-[orientation=vertical]:w-(--border-width) data-[orientation=vertical]:self-stretch",
        className,
      )}
      {...props}
    />
  );
}

const itemVariants = cva(
  "group/item flex w-full flex-wrap items-center outline-none transition-colors border-(length:--border-width) rounded-md text-2 duration-(--duration-fast) ease-standard [a&]:hover:bg-neutral-subtle focus-visible:ring-primary-focus-ring focus-visible:ring-(length:--focus-width) focus-visible:ring-offset-(length:--focus-offset) focus-visible:ring-offset-(color:--surface-page)",
  {
    variants: {
      variant: {
        plain: "border-(color:--surface-page)",
        outline: "border-neutral-border",
        muted: "bg-neutral-subtle border-neutral-subtle",
      },
      size: {
        xs: "px-(--item-padding-x-xs) py-(--item-padding-y-xs) gap-(--space-3)",
        sm: "px-(--item-padding-x-sm) py-(--item-padding-y-sm) gap-(--space-4)",
        md: "px-(--item-padding-x-md) py-(--item-padding-y-md) gap-(--space-5)",
      },
    },
    compoundVariants: [],
    defaultVariants: { variant: "plain", size: "md" },
  },
);

type Variant = "plain" | "outline" | "muted";
type Size = "xs" | "sm" | "md";
const aliases = { default: "plain" } as const;
type Alias = keyof typeof aliases;

function resolve(variant: Variant | Alias | undefined, size: Size | "default" | undefined) {
  const v =
    variant === undefined
      ? "plain"
      : variant in aliases
        ? aliases[variant as Alias]
        : (variant as Variant);
  return { variant: v, size: size === undefined || size === "default" ? "md" : size };
}

// Renders as a div; as a link it hovers.
function Item({
  className,
  variant,
  size,
  asChild = false,
  ...rest
}: React.ComponentProps<"div"> & { asChild?: boolean } & {
  variant?: Variant | Alias | undefined;
  size?: Size | "default" | undefined;
}) {
  const axes = resolve(variant, size);
  const props = React.useContext(ItemGroupContext) ? { role: "listitem", ...rest } : rest;
  const Comp = asChild ? Slot.Root : "div";
  return (
    <Comp
      data-slot="item"
      {...{ "data-variant": axes.variant, "data-size": axes.size }}
      className={cn(itemVariants(axes), className)}
      {...props}
    />
  );
}

// variant="icon" sizes an icon; variant="image" crops a picture to a square.
const itemMediaVariants = cva(
  "flex shrink-0 items-center justify-center [&_svg]:pointer-events-none group-has-data-[slot=item-description]/item:translate-y-0.5 group-has-data-[slot=item-description]/item:self-start gap-(--space-3)",
  {
    variants: {
      variant: {
        default: "bg-transparent",
        icon: "[&_svg]:size-4",
        image:
          "size-10 overflow-hidden rounded-(--radius-sm) group-data-[size=sm]/item:size-8 group-data-[size=xs]/item:size-6 [&_img]:size-full [&_img]:object-cover",
      },
    },
    defaultVariants: { variant: "default" },
  },
);

function ItemMedia({
  className,
  variant = "default",
  ...props
}: React.ComponentProps<"div"> & VariantProps<typeof itemMediaVariants>) {
  return (
    <div
      data-slot="item-media"
      data-variant={variant}
      className={cn(itemMediaVariants({ variant }), className)}
      {...props}
    />
  );
}

function ItemContent({ className, ...props }: React.ComponentProps<"div">) {
  return (
    <div
      data-slot="item-content"
      className={cn(
        "flex flex-1 flex-col [&+[data-slot=item-content]]:flex-none group-data-[size=xs]/item:gap-0 gap-(--space-2)",
        className,
      )}
      {...props}
    />
